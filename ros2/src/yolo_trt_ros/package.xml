<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yolo_trt_ros</name>
  <version>0.1.0</version>
  <description>把 YOLO 的 C++ 推理封装成 ROS2 节点，并给出分段延迟与显存测量</description>
  <maintainer email="2213730486@qq.com">DOURENCHI</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- CMakeLists.txt 里是 find_package(OpenCV REQUIRED)，
       这里必须声明，否则 rosdep install 不会装 libopencv-dev，
       colcon build 会报 "Could not find a package configuration file provided by OpenCV" -->
  <depend>opencv</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- BUILD_TESTING 下 find_package(ament_cmake_gtest REQUIRED) 需要它 -->
  <test_depend>ament_cmake_gtest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
